<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CyberPulse Pro • SOC Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #0b0f1c;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            color: #e5e9f0;
            padding: 24px;
        }
        .dashboard-container {
            max-width: 1800px;
            margin: 0 auto;
        }
        /* glassmorphic cards */
        .glass-card {
            background: rgba(18, 25, 40, 0.8);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(0, 212, 255, 0.15);
            border-radius: 24px;
            padding: 24px;
            box-shadow: 0 20px 40px -10px rgba(0,0,0,0.5);
        }
        .stat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 24px;
        }
        .stat-tile {
            background: linear-gradient(145deg, #111a2a, #0c1422);
            border-radius: 20px;
            padding: 20px;
            border-left: 4px solid #00d4ff;
            box-shadow: 0 10px 20px -5px rgba(0,212,255,0.2);
        }
        .stat-tile .label {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #7f8fa6;
        }
        .stat-tile .value {
            font-size: 2.8rem;
            font-weight: 700;
            line-height: 1.2;
            background: linear-gradient(135deg, #fff, #a0b0c8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .badge-critical { background: rgba(255,75,75,0.2); color: #ff5e5e; border: 1px solid #ff5e5e; }
        .badge-high { background: rgba(255,170,0,0.2); color: #ffb347; border: 1px solid #ffb347; }
        .badge-medium { background: rgba(0,212,255,0.2); color: #6dd5ff; border: 1px solid #00d4ff; }
        .badge-low { background: rgba(120,130,150,0.2); color: #a5b3ce; border: 1px solid #5f6f8a; }
        .ip-chip {
            background: #1e2a3a;
            padding: 6px 14px;
            border-radius: 40px;
            font-family: 'Fira Code', monospace;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .btn-cyber {
            background: transparent;
            border: 1.5px solid #00d4ff;
            color: #00d4ff;
            padding: 10px 24px;
            border-radius: 60px;
            font-weight: 600;
            transition: 0.2s;
        }
        .btn-cyber:hover {
            background: #00d4ff;
            color: #0b0f1c;
            box-shadow: 0 0 20px #00d4ff;
        }
        .btn-block {
            background: rgba(255,75,75,0.1);
            border: 1px solid #ff5e5e;
            color: #ff5e5e;
            padding: 6px 14px;
            border-radius: 40px;
            font-size: 0.8rem;
            font-weight: 600;
        }
        .btn-block:hover {
            background: #ff5e5e;
            color: #0b0f1c;
        }
        .btn-unblock {
            background: rgba(0,212,255,0.1);
            border: 1px solid #00d4ff;
            color: #00d4ff;
            padding: 6px 14px;
            border-radius: 40px;
            font-size: 0.8rem;
        }
        .table-modern {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 8px;
        }
        .table-modern th {
            color: #7f8fa6;
            font-weight: 500;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 12px 8px;
            border-bottom: 1px solid #1e2a3a;
        }
        .table-modern td {
            background: rgba(18,25,40,0.6);
            backdrop-filter: blur(4px);
            padding: 16px 12px;
            border-radius: 16px;
            font-size: 0.9rem;
            vertical-align: middle;
        }
        .toast-message {
            position: fixed;
            top: 24px;
            right: 24px;
            background: #1e2a3a;
            border-left: 6px solid #00d4ff;
            padding: 16px 24px;
            border-radius: 16px;
            box-shadow: 0 20px 40px -10px black;
            z-index: 9999;
            animation: slide 0.3s ease;
        }
        @keyframes slide { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
        .chart-container {
            background: rgba(18,25,40,0.6);
            border-radius: 24px;
            padding: 20px;
            margin-bottom: 24px;
        }
    </style>
</head>
<body>
<div class="dashboard-container">
    <!-- header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 style="font-weight: 700; background: linear-gradient(135deg,#fff,#00d4ff); -webkit-background-clip:text; -webkit-text-fill-color:transparent;">CYBERPULSE PRO</h1>
            <p class="text-secondary">real‑time threat intel & response · chicago time</p>
        </div>
        <div class="d-flex gap-3 align-items-center">
            <span class="ip-chip"><i class="fa-solid fa-circle text-success me-1" style="font-size: 0.6rem;"></i> API <span id="apiStatusLabel">online</span></span>
            <button class="btn-cyber" onclick="manualRefresh()"><i class="fa-solid fa-rotate"></i> refresh</button>
        </div>
    </div>

    <!-- stats tiles -->
    <div class="stat-grid">
        <div class="stat-tile"><div class="label">total attacks</div><div class="value" id="statTotal">0</div></div>
        <div class="stat-tile"><div class="label">critical</div><div class="value" style="color:#ff5e5e;" id="statCritical">0</div></div>
        <div class="stat-tile"><div class="label">high</div><div class="value" style="color:#ffb347;" id="statHigh">0</div></div>
        <div class="stat-tile"><div class="label">blocked ips</div><div class="value" id="statBlocked">0</div></div>
    </div>

    <!-- two charts -->
    <div class="row g-4 mb-4">
        <div class="col-md-8"><div class="chart-container"><canvas id="timelineChart" height="100"></canvas></div></div>
        <div class="col-md-4"><div class="chart-container"><canvas id="attackTypeChart" height="100"></canvas></div></div>
    </div>

    <!-- dual panel: alerts + blocked IPs -->
    <div class="row g-4">
        <!-- left: alerts table -->
        <div class="col-lg-8">
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4><i class="fa-solid fa-bolt me-2" style="color:#00d4ff;"></i> live attacks</h4>
                    <div><input type="text" class="form-control bg-transparent text-light border-secondary" placeholder="filter ip..." id="ipFilterInput" style="width:220px;"></div>
                </div>
                <table class="table-modern">
                    <thead><tr><th>time (chicago)</th><th>ip</th><th>type</th><th>severity</th><th>action</th></tr></thead>
                    <tbody id="alertsTableBody"></tbody>
                </table>
            </div>
        </div>
        <!-- right: blocked IPs panel -->
        <div class="col-lg-4">
            <div class="glass-card" style="height:100%;">
                <h4><i class="fa-solid fa-shield-halved me-2" style="color:#ff5e5e;"></i> blocked ips</h4>
                <div class="mt-3" style="max-height: 400px; overflow-y: auto;" id="blockedList">
                    <p class="text-secondary text-center">loading...</p>
                </div>
                <hr class="bg-secondary">
                <div class="d-flex gap-2">
                    <input type="text" class="form-control bg-transparent text-light" placeholder="manual ip" id="manualBlockIp">
                    <button class="btn-block" onclick="manualBlock()"><i class="fa-solid fa-ban"></i> block</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- toast container -->
<div id="toastArea"></div>

<script>
    const API_BASE = 'http://3.145.146.136:5000';
    let allAlerts = [];
    let blockedIPs = [];

    // toast
    function toast(msg, type='info') {
        const toast = document.createElement('div');
        toast.className = 'toast-message';
        toast.style.borderLeftColor = type==='success'?'#00d874':type==='error'?'#ff5e5e':'#00d4ff';
        toast.innerHTML = `<i class="fa-${type==='success'?'check-circle':type==='error'?'exclamation-circle':'info-circle'} me-2"></i>${msg}`;
        document.getElementById('toastArea').appendChild(toast);
        setTimeout(() => toast.remove(), 3500);
    }

    // chicago time formatter
    function chiTime(utc) {
        if (!utc) return new Date().toLocaleString('en-US',{timeZone:'America/Chicago'});
        return new Date(utc).toLocaleString('en-US',{timeZone:'America/Chicago', year:'numeric', month:'2-digit', day:'2-digit', hour:'2-digit', minute:'2-digit', second:'2-digit', hour12:true});
    }

    // fetch alerts & blocked
    async function fetchAll() {
        try {
            const [alertsRes, blockedRes] = await Promise.all([
                fetch(`${API_BASE}/api/security-alerts`),
                fetch(`${API_BASE}/api/blocked-ips`)
            ]);
            const alertsData = await alertsRes.json();
            const blockedData = await blockedRes.json();
            allAlerts = alertsData.alerts || [];
            blockedIPs = blockedData.blocked_ips || [];
            document.getElementById('apiStatusLabel').innerHTML = '<i class="fa-solid fa-circle text-success"></i> online';
            render();
        } catch (e) {
            document.getElementById('apiStatusLabel').innerHTML = '<i class="fa-solid fa-circle text-danger"></i> offline';
            toast('API unreachable, using demo data','error');
        }
    }

    // block IP
    async function blockIP(ip, reason='manual block') {
        try {
            await fetch(`${API_BASE}/api/automated-response/block-ip`, {
                method: 'POST',
                headers: {'Content-Type':'application/json'},
                body: JSON.stringify({ip_address: ip, reason})
            });
            toast(`⛔ blocked ${ip}`,'success');
            fetchAll();
        } catch { toast('block failed','error'); }
    }

    // unblock (simulate – you need backend endpoint)
    async function unblockIP(ip) {
        toast(`🔓 unblock ${ip} (demo)`, 'info');
        // if you had DELETE /api/blocked-ips/{ip} call it here
    }

    // manual block from input
    function manualBlock() {
        const ip = document.getElementById('manualBlockIp').value.trim();
        if (ip) { blockIP(ip); document.getElementById('manualBlockIp').value = ''; }
    }

    // render everything
    function render() {
        const filterIp = document.getElementById('ipFilterInput').value.toLowerCase();
        const filtered = filterIp ? allAlerts.filter(a => (a.detection?.ip_address || a.source_ip || '').toLowerCase().includes(filterIp)) : allAlerts;

        // stats
        let critical=0, high=0;
        filtered.forEach(a => { const s = a.severity; if(s==='critical') critical++; else if(s==='high') high++; });
        document.getElementById('statTotal').innerText = filtered.length;
        document.getElementById('statCritical').innerText = critical;
        document.getElementById('statHigh').innerText = high;
        document.getElementById('statBlocked').innerText = blockedIPs.length;

        // table
        const tbody = document.getElementById('alertsTableBody');
        tbody.innerHTML = '';
        filtered.slice(0, 30).forEach(alert => {
            const d = alert.detection || {};
            const ip = d.ip_address || alert.source_ip || '0.0.0.0';
            const type = d.event_type || alert.event_type || 'unknown';
            const sev = alert.severity || 'medium';
            const row = tbody.insertRow();
            row.innerHTML = `
                <td>${chiTime(alert.timestamp)}</td>
                <td><span class="ip-chip">${ip}</span></td>
                <td>${type}</td>
                <td><span class="badge-${sev} p-2 rounded-4">${sev.toUpperCase()}</span></td>
                <td><button class="btn-block" onclick="blockIP('${ip}')"><i class="fa-solid fa-ban"></i> block</button></td>
            `;
        });

        // blocked ips list
        const blkDiv = document.getElementById('blockedList');
        if (!blockedIPs.length) blkDiv.innerHTML = '<p class="text-secondary text-center">no blocked ips</p>';
        else {
            blkDiv.innerHTML = blockedIPs.map(b => `
                <div class="d-flex justify-content-between align-items-center mb-2 p-2" style="background:#1a2538; border-radius:60px;">
                    <span class="ip-chip">${b.ip || b}</span>
                    <button class="btn-unblock" onclick="unblockIP('${b.ip || b}')"><i class="fa-solid fa-lock-open"></i> unblock</button>
                </div>
            `).join('');
        }

        // update charts (simplified)
        const ctx1 = document.getElementById('timelineChart').getContext('2d');
        new Chart(ctx1, { type:'line', data: {
            labels: Array.from({length:12},(_,i)=>`${i*2}h`),
            datasets: [{ label:'attacks', data: Array(12).fill(0).map(()=>Math.floor(Math.random()*10+2)), borderColor:'#00d4ff' }]
        }, options: { responsive: true, maintainAspectRatio: false } });

        const ctx2 = document.getElementById('attackTypeChart').getContext('2d');
        new Chart(ctx2, { type:'doughnut', data: {
            labels: ['sqli','brute','xss','other'],
            datasets: [{ data: [45,30,15,10], backgroundColor:['#ff5e5e','#ffb347','#00d4ff','#7f8fa6'] }]
        }, options: { responsive: true } });
    }

    document.getElementById('ipFilterInput').addEventListener('input', render);
    window.manualRefresh = () => { fetchAll(); toast('refreshed','success'); };
    window.blockIP = blockIP; window.unblockIP = unblockIP; window.manualBlock = manualBlock;

    // init
    fetchAll();
    setInterval(fetchAll, 8000);
</script>
</body>
</html>
